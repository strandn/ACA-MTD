# vim:ft=plumed
MOLINFO STRUCTURE=ala3.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3

be: METAD ARG=phi3 HEIGHT=1.0 PACE=500 BIASFACTOR=8 SIGMA=0.25 GRID_MIN=-pi GRID_MAX=pi

PRINT ARG=phi2,psi2,phi3,psi3,be.bias FILE=COLVAR STRIDE=100
