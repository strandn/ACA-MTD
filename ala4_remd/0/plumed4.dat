# vim:ft=plumed
phi2: READ FILE=COLVAR.0.short VALUES=phi2 IGNORE_TIME
psi2: READ FILE=COLVAR.0.short VALUES=psi2 IGNORE_TIME
phi3: READ FILE=COLVAR.0.short VALUES=phi3 IGNORE_TIME
psi3: READ FILE=COLVAR.0.short VALUES=psi3 IGNORE_TIME
phi4: READ FILE=COLVAR.0.short VALUES=phi4 IGNORE_TIME
psi4: READ FILE=COLVAR.0.short VALUES=psi4 IGNORE_TIME

hhphi2psi2: HISTOGRAM ARG=phi2,psi2 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi2phi3: HISTOGRAM ARG=phi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi2psi3: HISTOGRAM ARG=phi2,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi2phi4: HISTOGRAM ARG=phi2,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi2psi4: HISTOGRAM ARG=phi2,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi2phi3: HISTOGRAM ARG=psi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi2psi3: HISTOGRAM ARG=psi2,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi2phi4: HISTOGRAM ARG=psi2,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi2psi4: HISTOGRAM ARG=psi2,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi3psi3: HISTOGRAM ARG=phi3,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi3phi4: HISTOGRAM ARG=phi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi3psi4: HISTOGRAM ARG=phi3,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi3phi4: HISTOGRAM ARG=psi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi3psi4: HISTOGRAM ARG=psi3,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi4psi4: HISTOGRAM ARG=phi4,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 CLEAR=50000

DUMPGRID GRID=hhphi2psi2 FILE=hhphi2psi2.dat STRIDE=50000
DUMPGRID GRID=hhphi2phi3 FILE=hhphi2phi3.dat STRIDE=50000
DUMPGRID GRID=hhphi2psi3 FILE=hhphi2psi3.dat STRIDE=50000
DUMPGRID GRID=hhphi2phi4 FILE=hhphi2phi4.dat STRIDE=50000
DUMPGRID GRID=hhphi2psi4 FILE=hhphi2psi4.dat STRIDE=50000
DUMPGRID GRID=hhpsi2phi3 FILE=hhpsi2phi3.dat STRIDE=50000
DUMPGRID GRID=hhpsi2psi3 FILE=hhpsi2psi3.dat STRIDE=50000
DUMPGRID GRID=hhpsi2phi4 FILE=hhpsi2phi4.dat STRIDE=50000
DUMPGRID GRID=hhpsi2psi4 FILE=hhpsi2psi4.dat STRIDE=50000
DUMPGRID GRID=hhphi3psi3 FILE=hhphi3psi3.dat STRIDE=50000
DUMPGRID GRID=hhphi3phi4 FILE=hhphi3phi4.dat STRIDE=50000
DUMPGRID GRID=hhphi3psi4 FILE=hhphi3psi4.dat STRIDE=50000
DUMPGRID GRID=hhpsi3phi4 FILE=hhpsi3phi4.dat STRIDE=50000
DUMPGRID GRID=hhpsi3psi4 FILE=hhpsi3psi4.dat STRIDE=50000
DUMPGRID GRID=hhphi4psi4 FILE=hhphi4psi4.dat STRIDE=50000
