# vim:ft=plumed
MOLINFO STRUCTURE=diala.pdb
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2

metad: TTMETAD ARG=phi,psi ...
PACE=500 HEIGHT=1.0
BIASFACTOR=8
SIGMA=0.25,0.25
SKETCH_INITRANK=30 SKETCH_CUTOFF=1.0e-6
SKETCH_PACE=5000000
INTERVAL_MIN=-pi,-pi INTERVAL_MAX=pi,pi
SKETCH_NBASIS=20
VB_CUTOFF=1.0e-6
...

PRINT ARG=phi,psi,metad.bias FILE=colvar.dat STRIDE=100
