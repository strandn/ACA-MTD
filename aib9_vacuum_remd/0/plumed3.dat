DUMPGRID GRID=ffpsi5 FILE=ffpsi5.dat
DUMPGRID GRID=ffphi6 FILE=ffphi6.dat
DUMPGRID GRID=ffpsi6 FILE=ffpsi6.dat
DUMPGRID GRID=ffphi7 FILE=ffphi7.dat
DUMPGRID GRID=ffpsi7 FILE=ffpsi7.dat
DUMPGRID GRID=ffphi8 FILE=ffphi8.dat
DUMPGRID GRID=ffpsi8 FILE=ffpsi8.dat
DUMPGRID GRID=ffphi9 FILE=ffphi9.dat
DUMPGRID GRID=ffpsi9 FILE=ffpsi9.dat
