# vim:ft=plumed
# RESTART
MOLINFO STRUCTURE=diala.pdb
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2

ttsketch: TTSKETCH ARG=phi,psi ...
INITRANK=20
CUTOFF=0.000001
PACE=5000000 SAMPLESTRIDE=500
INTERVAL_MIN=-pi,-pi INTERVAL_MAX=pi,pi
NBASIS=20
VMAX=20
NBINS=1000 WIDTH=0.08,0.08
NOCONV
BIASFACTOR=1
FILE=../colvar.dat PRINTSTRIDE=100
WALKERS_MPI
DO_ACA ACA_CUTOFF=0.1 ACA_RANK=50 ACA_NBINS=100 ACA_NOCONV
...

PRINT ARG=phi,psi,ttsketch.bias FILE=colvar.dat STRIDE=100 FMT=%20.15f
