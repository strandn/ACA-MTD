# vim:ft=plumed
phi2: READ FILE=colvar.dat VALUES=phi2
psi2: READ FILE=colvar.dat VALUES=psi2
phi3: READ FILE=colvar.dat VALUES=phi3
psi3: READ FILE=colvar.dat VALUES=psi3

TT_FES ARG=phi2,psi2,phi3,psi3 ...
GRID_MIN=-pi,-pi,-pi,-pi GRID_MAX=pi,pi,pi,pi
GRID_BIN_1D=500 GRID_BIN_2D=100
ACA_RANK=50 ACA_CUTOFF=1.0e-3
ITER=20 PACE=50000
STRIDE=5 SAMPLEFILE=colvar.dat FILE=fes.dat
TEMP=300
...
