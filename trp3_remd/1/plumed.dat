# vim:ft=plumed
MOLINFO STRUCTURE=trp3.pdb
phi1: TORSION ATOMS=5,7,9,29
psi1: TORSION ATOMS=7,9,29,31
chi11: TORSION ATOMS=7,9,11,14
chi12: TORSION ATOMS=9,11,14,15
phi2: TORSION ATOMS=29,31,33,53
psi2: TORSION ATOMS=31,33,53,55
chi21: TORSION ATOMS=31,33,35,38
chi22: TORSION ATOMS=33,35,38,39

energy: ENERGY

PRINT ARG=phi1,psi1,chi11,chi12,phi2,psi2,chi21,chi22,energy FILE=COLVAR STRIDE=100 FMT=%20.15f
