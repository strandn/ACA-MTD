# vim:ft=plumed
phi2: READ FILE=colvar.dat VALUES=phi2 IGNORE_TIME
psi2: READ FILE=colvar.dat VALUES=psi2 IGNORE_TIME
phi3: READ FILE=colvar.dat VALUES=phi3 IGNORE_TIME
psi3: READ FILE=colvar.dat VALUES=psi3 IGNORE_TIME
phi4: READ FILE=colvar.dat VALUES=phi4 IGNORE_TIME
psi4: READ FILE=colvar.dat VALUES=psi4 IGNORE_TIME

hhphi2psi2: HISTOGRAM ARG=phi2,psi2 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi2phi3: HISTOGRAM ARG=psi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi3psi3: HISTOGRAM ARG=phi3,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhpsi3phi4: HISTOGRAM ARG=psi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi4psi4: HISTOGRAM ARG=phi4,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
DUMPGRID GRID=hhphi2psi2 FILE=hhphi2psi2.dat STRIDE=50000
DUMPGRID GRID=hhpsi2phi3 FILE=hhpsi2phi3.dat STRIDE=50000
DUMPGRID GRID=hhphi3psi3 FILE=hhphi3psi3.dat STRIDE=50000
DUMPGRID GRID=hhpsi3phi4 FILE=hhpsi3phi4.dat STRIDE=50000
DUMPGRID GRID=hhphi4psi4 FILE=hhphi4psi4.dat STRIDE=50000
