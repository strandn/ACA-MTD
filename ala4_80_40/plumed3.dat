# vim:ft=plumed
phi2: READ FILE=colvar.dat VALUES=phi2 IGNORE_TIME
psi2: READ FILE=colvar.dat VALUES=psi2 IGNORE_TIME
phi3: READ FILE=colvar.dat VALUES=phi3 IGNORE_TIME
psi3: READ FILE=colvar.dat VALUES=psi3 IGNORE_TIME
phi4: READ FILE=colvar.dat VALUES=phi4 IGNORE_TIME
psi4: READ FILE=colvar.dat VALUES=psi4 IGNORE_TIME
ttsketch: READ FILE=colvar.dat VALUES=ttsketch.bias IGNORE_TIME

as: REWEIGHT_BIAS ARG=ttsketch.bias TEMP=300

hhphi2psi2: HISTOGRAM ARG=phi2,psi2 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi2phi3: HISTOGRAM ARG=phi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi2psi3: HISTOGRAM ARG=phi2,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi2phi4: HISTOGRAM ARG=phi2,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi2psi4: HISTOGRAM ARG=phi2,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2phi3: HISTOGRAM ARG=psi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2psi3: HISTOGRAM ARG=psi2,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2phi4: HISTOGRAM ARG=psi2,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2psi4: HISTOGRAM ARG=psi2,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi3psi3: HISTOGRAM ARG=phi3,psi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi3phi4: HISTOGRAM ARG=phi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi3psi4: HISTOGRAM ARG=phi3,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi3phi4: HISTOGRAM ARG=psi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhpsi3psi4: HISTOGRAM ARG=psi3,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true
hhphi4psi4: HISTOGRAM ARG=phi4,psi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.1,0.1 LOGWEIGHTS=as NORMALIZATION=true

ffphi2psi2: CONVERT_TO_FES GRID=hhphi2psi2 TEMP=300
ffphi2phi3: CONVERT_TO_FES GRID=hhphi2phi3 TEMP=300
ffphi2psi3: CONVERT_TO_FES GRID=hhphi2psi3 TEMP=300
ffphi2phi4: CONVERT_TO_FES GRID=hhphi2phi4 TEMP=300
ffphi2psi4: CONVERT_TO_FES GRID=hhphi2psi4 TEMP=300
ffpsi2phi3: CONVERT_TO_FES GRID=hhpsi2phi3 TEMP=300
ffpsi2psi3: CONVERT_TO_FES GRID=hhpsi2psi3 TEMP=300
ffpsi2phi4: CONVERT_TO_FES GRID=hhpsi2phi4 TEMP=300
ffpsi2psi4: CONVERT_TO_FES GRID=hhpsi2psi4 TEMP=300
ffphi3psi3: CONVERT_TO_FES GRID=hhphi3psi3 TEMP=300
ffphi3phi4: CONVERT_TO_FES GRID=hhphi3phi4 TEMP=300
ffphi3psi4: CONVERT_TO_FES GRID=hhphi3psi4 TEMP=300
ffpsi3phi4: CONVERT_TO_FES GRID=hhpsi3phi4 TEMP=300
ffpsi3psi4: CONVERT_TO_FES GRID=hhpsi3psi4 TEMP=300
ffphi4psi4: CONVERT_TO_FES GRID=hhphi4psi4 TEMP=300

DUMPGRID GRID=ffphi2psi2 FILE=ffphi2psi2.dat
DUMPGRID GRID=ffphi2phi3 FILE=ffphi2phi3.dat
DUMPGRID GRID=ffphi2psi3 FILE=ffphi2psi3.dat
DUMPGRID GRID=ffphi2phi4 FILE=ffphi2phi4.dat
DUMPGRID GRID=ffphi2psi4 FILE=ffphi2psi4.dat
DUMPGRID GRID=ffpsi2phi3 FILE=ffpsi2phi3.dat
DUMPGRID GRID=ffpsi2psi3 FILE=ffpsi2psi3.dat
DUMPGRID GRID=ffpsi2phi4 FILE=ffpsi2phi4.dat
DUMPGRID GRID=ffpsi2psi4 FILE=ffpsi2psi4.dat
DUMPGRID GRID=ffphi3psi3 FILE=ffphi3psi3.dat
DUMPGRID GRID=ffphi3phi4 FILE=ffphi3phi4.dat
DUMPGRID GRID=ffphi3psi4 FILE=ffphi3psi4.dat
DUMPGRID GRID=ffpsi3phi4 FILE=ffpsi3phi4.dat
DUMPGRID GRID=ffpsi3psi4 FILE=ffpsi3psi4.dat
DUMPGRID GRID=ffphi4psi4 FILE=ffphi4psi4.dat
