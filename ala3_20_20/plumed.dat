# vim:ft=plumed
MOLINFO STRUCTURE=ala3.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3

ttsketch: TTSKETCH ARG=phi2,psi2,phi3,psi3 ...
INITRANK=20
CUTOFF=0.000001
PACE=5000000 SAMPLESTRIDE=500
INTERVAL_MIN=-pi,-pi,-pi,-pi INTERVAL_MAX=pi,pi,pi,pi
NBASIS=20
VMAX=20
NBINS=1000 WIDTH=0.08
BIASFACTOR=1
ACA_RANK=30 ACA_CUTOFF=0.05
...

as: REWEIGHT_BIAS

hhphi2: HISTOGRAM ARG=phi2 STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2: HISTOGRAM ARG=psi2 STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hhphi3: HISTOGRAM ARG=phi3 STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hhpsi3: HISTOGRAM ARG=psi3 STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
ffphi2: CONVERT_TO_FES GRID=hhphi2
ffpsi2: CONVERT_TO_FES GRID=hhpsi2
ffphi3: CONVERT_TO_FES GRID=hhphi3
ffpsi3: CONVERT_TO_FES GRID=hhpsi3
DUMPGRID GRID=ffphi2 FILE=ffphi2.dat STRIDE=5000000
DUMPGRID GRID=ffpsi2 FILE=ffpsi2.dat STRIDE=5000000
DUMPGRID GRID=ffphi3 FILE=ffphi3.dat STRIDE=5000000
DUMPGRID GRID=ffpsi3 FILE=ffpsi3.dat STRIDE=5000000

PRINT ARG=phi2,psi2,phi3,psi3,ttsketch.bias FILE=colvar.dat STRIDE=100
