# vim:ft=plumed
phi2: READ FILE=COLVAR.1 VALUES=phi2 IGNORE_TIME
psi2: READ FILE=COLVAR.1 VALUES=psi2 IGNORE_TIME
phi3: READ FILE=COLVAR.1 VALUES=phi3 IGNORE_TIME
psi3: READ FILE=COLVAR.1 VALUES=psi3 IGNORE_TIME
energy: READ FILE=COLVAR.1 VALUES=energy IGNORE_TIME

rtp: REWEIGHT_TEMP_PRESS TEMP=400 REWEIGHT_TEMP=300 ENERGY=energy

hhphi2: HISTOGRAM ARG=phi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=rtp NORMALIZATION=true
hhpsi2: HISTOGRAM ARG=psi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.05 LOGWEIGHTS=rtp NORMALIZATION=true
hhphi3: HISTOGRAM ARG=phi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=rtp NORMALIZATION=true
hhpsi3: HISTOGRAM ARG=psi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.05 LOGWEIGHTS=rtp NORMALIZATION=true
DUMPGRID GRID=hhphi2 FILE=hhphi2.dat STRIDE=50000
DUMPGRID GRID=hhpsi2 FILE=hhpsi2.dat STRIDE=50000
DUMPGRID GRID=hhphi3 FILE=hhphi3.dat STRIDE=50000
DUMPGRID GRID=hhpsi3 FILE=hhpsi3.dat STRIDE=50000
