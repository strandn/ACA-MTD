# vim:ft=plumed
phi2: READ FILE=COLVAR VALUES=phi2 IGNORE_TIME
psi2: READ FILE=COLVAR VALUES=psi2 IGNORE_TIME
phi3: READ FILE=COLVAR VALUES=phi3 IGNORE_TIME
psi3: READ FILE=COLVAR VALUES=psi3 IGNORE_TIME
phi4: READ FILE=COLVAR VALUES=phi4 IGNORE_TIME
psi4: READ FILE=COLVAR VALUES=psi4 IGNORE_TIME

hhphi2: HISTOGRAM ARG=phi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
hhpsi2: HISTOGRAM ARG=psi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
hhphi3: HISTOGRAM ARG=phi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
hhpsi3: HISTOGRAM ARG=psi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
hhphi4: HISTOGRAM ARG=phi4 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
hhpsi4: HISTOGRAM ARG=psi4 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.05 CLEAR=50000
DUMPGRID GRID=hhphi2 FILE=hhphi2_clear.dat STRIDE=50000
DUMPGRID GRID=hhpsi2 FILE=hhpsi2_clear.dat STRIDE=50000
DUMPGRID GRID=hhphi3 FILE=hhphi3_clear.dat STRIDE=50000
DUMPGRID GRID=hhpsi3 FILE=hhpsi3_clear.dat STRIDE=50000
DUMPGRID GRID=hhphi4 FILE=hhphi4_clear.dat STRIDE=50000
DUMPGRID GRID=hhpsi4 FILE=hhpsi4_clear.dat STRIDE=50000
