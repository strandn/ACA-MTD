# vim:ft=plumed
RESTART
MOLINFO STRUCTURE=ala4.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3
phi4: TORSION ATOMS=@phi-4
psi4: TORSION ATOMS=@psi-4

mtd: METAD ARG=psi2,phi3,psi3,phi4 HEIGHT=0.3 PACE=5000 BIASFACTOR=8 SIGMA=0.5,0.5,0.5,0.5 GRID_MIN=-pi,-pi,-pi,-pi GRID_MAX=pi,pi,pi,pi CALC_RCT

PRINT ARG=phi2,psi2,phi3,psi3,phi4,psi4,mtd.rbias FILE=COLVAR STRIDE=100 FMT=%20.15f
