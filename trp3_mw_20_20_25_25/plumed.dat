# vim:ft=plumed
# RESTART
MOLINFO STRUCTURE=trp3.pdb
phi1: TORSION ATOMS=5,7,9,29
psi1: TORSION ATOMS=7,9,29,31
chi11: TORSION ATOMS=7,9,11,14
chi12: TORSION ATOMS=9,11,14,15
phi2: TORSION ATOMS=29,31,33,53
psi2: TORSION ATOMS=31,33,53,55
chi21: TORSION ATOMS=31,33,35,38
chi22: TORSION ATOMS=33,35,38,39

ttsketch: TTSKETCH ARG=phi1,psi1,chi11,chi12,phi2,psi2,chi21,chi22 ...
INITRANK=20
CUTOFF=0.000001
PACE=5000000 SAMPLESTRIDE=500
INTERVAL_MIN=-pi,-pi,-pi,-pi,-pi,-pi,-pi,-pi INTERVAL_MAX=pi,pi,pi,pi,pi,pi,pi,pi
NBASIS=20
VMAX=25 ADJ_VMAX=25
NBINS=1000 WIDTH=0.12,0.12,0.12,0.12,0.12,0.12,0.12,0.12
BIASFACTOR=1
FILE=../colvar.dat PRINTSTRIDE=100
WALKERS_MPI
...

PRINT ARG=phi1,psi1,chi11,chi12,phi2,psi2,chi21,chi22,ttsketch.adjbias FILE=colvar.dat STRIDE=100 FMT=%20.15f
