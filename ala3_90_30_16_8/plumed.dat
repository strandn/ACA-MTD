# vim:ft=plumed
# RESTART
MOLINFO STRUCTURE=ala3.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3

ttsketch: TTSKETCH ARG=phi2,psi2,phi3,psi3 ...
INITRANK=90
CUTOFF=0.00000001
PACE=5000000 SAMPLESTRIDE=500 MEMORYSTRIDE=5000
INTERVAL_MIN=-pi,-pi,-pi,-pi INTERVAL_MAX=pi,pi,pi,pi
NBASIS=30
VMAX=20
NBINS=1000 WIDTH=0.16,0.16,0.16,0.16
BIASFACTOR=1
FILE=../colvar.dat PRINTSTRIDE=100
WALKERS_MPI
...

PRINT ARG=phi2,psi2,phi3,psi3,ttsketch.bias FILE=colvar.dat STRIDE=100 FMT=%20.15f
