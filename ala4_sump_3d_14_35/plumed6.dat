# vim:ft=plumed
phi2: READ FILE=colvar.dat VALUES=phi2 IGNORE_TIME
phi3: READ FILE=colvar.dat VALUES=phi3 IGNORE_TIME
phi4: READ FILE=colvar.dat VALUES=phi4 IGNORE_TIME

hhphi2phi3: HISTOGRAM ARG=phi2,phi3 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi2phi4: HISTOGRAM ARG=phi2,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
hhphi3phi4: HISTOGRAM ARG=phi3,phi4 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=50,50 BANDWIDTH=0.1,0.1 CLEAR=50000
DUMPGRID GRID=hhphi2phi3 FILE=hhphi2phi3.dat STRIDE=50000
DUMPGRID GRID=hhphi2phi4 FILE=hhphi2phi4.dat STRIDE=50000
DUMPGRID GRID=hhphi3phi4 FILE=hhphi3phi4.dat STRIDE=50000
