# vim:ft=plumed
MOLINFO STRUCTURE=ala3.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3

TT_FES ARG=phi2,psi2,phi3,psi3 ...
GRID_MIN=-pi,-pi,-pi,-pi GRID_MAX=pi,pi,pi,pi
GRID_BIN_1D=500 GRID_BIN_2D=100
ACA_RANK=50 ACA_CUTOFF=1.0e-6
STRIDE=1 SAMPLEFILE=colvar.dat
ITER=1
...

PRINT ARG=phi2,psi2,phi3,psi3,ttsketch.bias FILE=colvar.dat STRIDE=100
