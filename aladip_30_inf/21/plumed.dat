# vim:ft=plumed
# RESTART
MOLINFO STRUCTURE=diala.pdb
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2

ttsketch: TTSKETCH ARG=phi,psi ...
INITRANK=30
CUTOFF=0.000001
PACE=5000000 SAMPLESTRIDE=500 MEMORYSTRIDE=5000
INTERVAL_MIN=-pi,-pi INTERVAL_MAX=pi,pi
NBASIS=30
ADJ_VMAX=20
NBINS=1000 WIDTH=0.12,0.12
BIASFACTOR=1
FILE=../colvar.dat PRINTSTRIDE=100
WALKERS_MPI
...

PRINT ARG=phi,psi,ttsketch.bias,ttsketch.adjbias FILE=colvar.dat STRIDE=100 FMT=%20.15f
