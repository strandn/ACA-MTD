# vim:ft=plumed
phi: READ FILE=colvar.dat VALUES=phi IGNORE_TIME
psi: READ FILE=colvar.dat VALUES=psi IGNORE_TIME
ttsketch: READ FILE=colvar.dat VALUES=ttsketch.adjbias IGNORE_TIME

as: REWEIGHT_BIAS ARG=ttsketch.adjbias TEMP=300

hhphi: HISTOGRAM ARG=phi GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hhpsi: HISTOGRAM ARG=psi GRID_MIN=-pi GRID_MAX=pi GRID_BIN=100 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
ffphi: CONVERT_TO_FES GRID=hhphi TEMP=300
ffpsi: CONVERT_TO_FES GRID=hhpsi TEMP=300
DUMPGRID GRID=ffphi FILE=ffphi_adj.dat STRIDE=50000
DUMPGRID GRID=ffpsi FILE=ffpsi_adj.dat STRIDE=50000
