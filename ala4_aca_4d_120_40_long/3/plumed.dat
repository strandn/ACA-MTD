# vim:ft=plumed
# RESTART
MOLINFO STRUCTURE=ala4.pdb
phi2: TORSION ATOMS=@phi-2
psi2: TORSION ATOMS=@psi-2
phi3: TORSION ATOMS=@phi-3
psi3: TORSION ATOMS=@psi-3
phi4: TORSION ATOMS=@phi-4
psi4: TORSION ATOMS=@psi-4

ttsketch: TTSKETCH ARG=psi2,phi3,psi3,phi4 ...
INITRANK=120 RANK=4 KERNEL_BASIS
PACE=5000000 SAMPLESTRIDE=500 MEMORYSTRIDE=5000
INTERVAL_MIN=-pi,-pi,-pi,-pi INTERVAL_MAX=pi,pi,pi,pi
NBASIS=40
VMAX=40
ADJ_VMAX=40
NBINS=1000 WIDTH=0.03,0.03,0.03,0.03
BIASFACTOR=1
FILE=../colvar.dat PRINTSTRIDE=100
WALKERS_MPI
DO_ACA ACA_RANK=50 ACA_AUTO_RANK
...

PRINT ARG=phi2,psi2,phi3,psi3,phi4,psi4,ttsketch.bias,ttsketch.adjbias FILE=colvar.dat STRIDE=100 FMT=%20.15f
