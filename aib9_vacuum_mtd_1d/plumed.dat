# vim:ft=plumed
MOLINFO STRUCTURE=aib9.pdb
phi1: TORSION ATOMS=5,7,9,18
psi1: TORSION ATOMS=7,9,18,20
phi2: TORSION ATOMS=18,20,22,31
psi2: TORSION ATOMS=20,22,31,33
phi3: TORSION ATOMS=31,33,35,44
psi3: TORSION ATOMS=33,35,44,46
phi4: TORSION ATOMS=44,46,48,57
psi4: TORSION ATOMS=46,48,57,59
phi5: TORSION ATOMS=57,59,61,70
psi5: TORSION ATOMS=59,61,70,72
phi6: TORSION ATOMS=70,72,74,83
psi6: TORSION ATOMS=72,74,83,85
phi7: TORSION ATOMS=83,85,87,96
psi7: TORSION ATOMS=85,87,96,98
phi8: TORSION ATOMS=96,98,100,109
psi8: TORSION ATOMS=98,100,109,111
phi9: TORSION ATOMS=109,111,113,122
psi9: TORSION ATOMS=111,113,122,124
phi: COMBINE ARG=phi1,phi2,phi3,phi4,phi5,phi6,phi7,phi8,phi9 POWERS=1,1,1,1,1,1,1,1,1 COEFFICIENTS=1/9,1/9,1/9,1/9,1/9,1/9,1/9,1/9,1/9 PERIODIC=-pi,pi
psi: COMBINE ARG=psi1,psi2,psi3,psi4,psi5,psi6,psi7,psi8,psi9 POWERS=1,1,1,1,1,1,1,1,1 COEFFICIENTS=1/9,1/9,1/9,1/9,1/9,1/9,1/9,1/9,1/9 PERIODIC=-pi,pi

mtd: METAD ARG=phi HEIGHT=1.0 PACE=500 BIASFACTOR=10 SIGMA=0.25 GRID_MIN=-pi GRID_MAX=pi CALC_RCT

as: REWEIGHT_METAD

hhphi1: HISTOGRAM ARG=phi1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi1: HISTOGRAM ARG=psi1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi2: HISTOGRAM ARG=phi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi2: HISTOGRAM ARG=psi2 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi3: HISTOGRAM ARG=phi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi3: HISTOGRAM ARG=psi3 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi4: HISTOGRAM ARG=phi4 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi4: HISTOGRAM ARG=psi4 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi5: HISTOGRAM ARG=phi5 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi5: HISTOGRAM ARG=psi5 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi6: HISTOGRAM ARG=phi6 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi6: HISTOGRAM ARG=psi6 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi7: HISTOGRAM ARG=phi7 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi7: HISTOGRAM ARG=psi7 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi8: HISTOGRAM ARG=phi8 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi8: HISTOGRAM ARG=psi8 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhphi9: HISTOGRAM ARG=phi9 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true
hhpsi9: HISTOGRAM ARG=psi9 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.025 LOGWEIGHTS=as NORMALIZATION=true

ffphi1: CONVERT_TO_FES GRID=hhphi1
ffpsi1: CONVERT_TO_FES GRID=hhpsi1
ffphi2: CONVERT_TO_FES GRID=hhphi2
ffpsi2: CONVERT_TO_FES GRID=hhpsi2
ffphi3: CONVERT_TO_FES GRID=hhphi3
ffpsi3: CONVERT_TO_FES GRID=hhpsi3
ffphi4: CONVERT_TO_FES GRID=hhphi4
ffpsi4: CONVERT_TO_FES GRID=hhpsi4
ffphi5: CONVERT_TO_FES GRID=hhphi5
ffpsi5: CONVERT_TO_FES GRID=hhpsi5
ffphi6: CONVERT_TO_FES GRID=hhphi6
ffpsi6: CONVERT_TO_FES GRID=hhpsi6
ffphi7: CONVERT_TO_FES GRID=hhphi7
ffpsi7: CONVERT_TO_FES GRID=hhpsi7
ffphi8: CONVERT_TO_FES GRID=hhphi8
ffpsi8: CONVERT_TO_FES GRID=hhpsi8
ffphi9: CONVERT_TO_FES GRID=hhphi9
ffpsi9: CONVERT_TO_FES GRID=hhpsi9

DUMPGRID GRID=ffphi1 FILE=ffphi1.dat STRIDE=10000000
DUMPGRID GRID=ffpsi1 FILE=ffpsi1.dat STRIDE=10000000
DUMPGRID GRID=ffphi2 FILE=ffphi2.dat STRIDE=10000000
DUMPGRID GRID=ffpsi2 FILE=ffpsi2.dat STRIDE=10000000
DUMPGRID GRID=ffphi3 FILE=ffphi3.dat STRIDE=10000000
DUMPGRID GRID=ffpsi3 FILE=ffpsi3.dat STRIDE=10000000
DUMPGRID GRID=ffphi4 FILE=ffphi4.dat STRIDE=10000000
DUMPGRID GRID=ffpsi4 FILE=ffpsi4.dat STRIDE=10000000
DUMPGRID GRID=ffphi5 FILE=ffphi5.dat STRIDE=10000000
DUMPGRID GRID=ffpsi5 FILE=ffpsi5.dat STRIDE=10000000
DUMPGRID GRID=ffphi6 FILE=ffphi6.dat STRIDE=10000000
DUMPGRID GRID=ffpsi6 FILE=ffpsi6.dat STRIDE=10000000
DUMPGRID GRID=ffphi7 FILE=ffphi7.dat STRIDE=10000000
DUMPGRID GRID=ffpsi7 FILE=ffpsi7.dat STRIDE=10000000
DUMPGRID GRID=ffphi8 FILE=ffphi8.dat STRIDE=10000000
DUMPGRID GRID=ffpsi8 FILE=ffpsi8.dat STRIDE=10000000
DUMPGRID GRID=ffphi9 FILE=ffphi9.dat STRIDE=10000000
DUMPGRID GRID=ffpsi9 FILE=ffpsi9.dat STRIDE=10000000

PRINT ARG=phi,psi,mtd.bias FILE=COLVAR STRIDE=100
