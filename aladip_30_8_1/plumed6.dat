# vim:ft=plumed
MOLINFO STRUCTURE=diala.pdb
phi: TORSION ATOMS=@phi-2
psi: TORSION ATOMS=@psi-2

ttsketch: TTSKETCH ARG=phi,psi ...
INITRANK=30
CUTOFF=0.000001
PACE=5000000 SAMPLESTRIDE=100
INTERVAL_MIN=-pi,-pi INTERVAL_MAX=pi,pi
NBASIS=30
VMAX=20
NBINS=1000 WIDTH=0.08
BIASFACTOR=1
ACA_RANK=30 ACA_CUTOFF=0.05
...

as: REWEIGHT_BIAS

hhphi: HISTOGRAM ARG=phi STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hhpsi: HISTOGRAM ARG=psi STRIDE=100 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=500 BANDWIDTH=0.035 LOGWEIGHTS=as NORMALIZATION=true
hh2d: HISTOGRAM ARG=phi,psi STRIDE=100 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=100,100 BANDWIDTH=0.08,0.08 LOGWEIGHTS=as NORMALIZATION=true
ffphi: CONVERT_TO_FES GRID=hhphi
ffpsi: CONVERT_TO_FES GRID=hhpsi
ff2d: CONVERT_TO_FES GRID=hh2d
DUMPGRID GRID=ffphi FILE=ffphi.dat STRIDE=5000000
DUMPGRID GRID=ffpsi FILE=ffpsi.dat STRIDE=5000000
DUMPGRID GRID=ff2d FILE=ff2d.dat STRIDE=5000000

PRINT ARG=phi,psi,ttsketch.bias FILE=colvar.dat STRIDE=100
